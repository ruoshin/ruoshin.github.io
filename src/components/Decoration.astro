---
type Variant = "squiggle" | "spark" | "star" | "blob" | "dots" | "arc" | "hump";

interface Props {
  variant: Variant;
  color?: "accent" | "secondary";
  class?: string;
}

const { variant, color = "accent", class: className = "" } = Astro.props;
const stroke =
  color === "accent" ? "var(--color-accent)" : "var(--color-secondary)";

const viewBoxes: Record<Variant, string> = {
  squiggle: "0 0 140 60",
  spark: "0 0 24 24",
  star: "0 0 40 40",
  blob: "0 0 140 140",
  dots: "0 0 64 20",
  arc: "0 0 120 70",
  hump: "0 0 120 70",
};
---

<svg
  viewBox={viewBoxes[variant]}
  fill="none"
  class={className}
  aria-hidden="true"
>
  {
    variant === "squiggle" && (
      <path
        d="M14 30 C 30 -4 54 -4 70 30 S 110 64 126 30"
        stroke={stroke}
        stroke-width="18"
        stroke-linecap="round"
        fill="none"
      />
    )
  }
  {
    variant === "spark" && (
      <path
        d="M12 1 L13.6 10.4 L23 12 L13.6 13.6 L12 23 L10.4 13.6 L1 12 L10.4 10.4 Z"
        fill={stroke}
      />
    )
  }
  {
    variant === "star" && (
      <path
        d="M20 0 L22.5 14 L36 16.5 L24 22 L30 38 L20 28 L10 38 L16 22 L4 16.5 L17.5 14 Z"
        fill={stroke}
      />
    )
  }
  {
    variant === "blob" && (
      <path
        d="M70 6 C 105 6 134 32 134 68 C 134 102 110 134 70 134 C 26 134 6 100 6 64 C 6 26 35 6 70 6 Z"
        fill={stroke}
      />
    )
  }
  {
    variant === "dots" && (
      <>
        <circle cx="6" cy="10" r="3" fill={stroke} />
        <circle cx="22" cy="10" r="3" fill={stroke} />
        <circle cx="38" cy="10" r="3" fill={stroke} />
        <circle cx="54" cy="10" r="3" fill={stroke} />
      </>
    )
  }
  {
    variant === "arc" && (
      <path
        d="M16 58 A 44 44 0 0 1 104 58"
        stroke={stroke}
        stroke-width="18"
        stroke-linecap="round"
        fill="none"
      />
    )
  }
  {
    variant === "hump" && (
      <path
        d="M14 56 C 30 8 50 8 60 36 C 70 64 90 64 106 16"
        stroke={stroke}
        stroke-width="18"
        stroke-linecap="round"
        fill="none"
      />
    )
  }
</svg>
