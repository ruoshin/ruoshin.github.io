---
import Pot from "./Pot.astro";
import Tree from "./Tree.astro";
import Plant from "./Plant.astro";
import Kinoko from "./Kinoko.astro";
import Flower from "./Flower.astro";
import {
  bonsaiPlants,
  bonsaiDecorations,
  bonsaiTreeExperienceId,
  bonsaiTreeColor,
} from "@/data/bonsai-mapping";
import { experience } from "@/data/experience";
import { getLocale } from "@/lib/i18n";

const orbiterGlyphs = { plant: Plant, kinoko: Kinoko, flower: Flower } as const;

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const experienceById = new Map(experience.map((e) => [e.id, e]));

const treeJob = experienceById.get(bonsaiTreeExperienceId);
if (!treeJob) {
  throw new Error(
    `bonsai-mapping: unknown tree experienceId "${bonsaiTreeExperienceId}"`,
  );
}
const treeRole = treeJob.role[locale];
const treeCompany = treeJob.shortName?.[locale] ?? treeJob.company;
const treeLabel = `${treeRole} · ${treeCompany}`;
---

<div class={`bonsai-perspective ${className}`}>
  <!-- Four layers in DOM = paint order. The middle two are flat 2D
       (unlike the 3D contexts above and below them) so the visible rim
       band is uniform all the way around, which a 3D-tilted disc with a
       CSS border can't produce.
         1. Pot body  (back, 3D, -20° tilt) — trapezoid only
         2. Pot rim   (mid, 2D) — solid clay ellipse
         3. Soil      (mid, 2D) — smaller green ellipse on top of the rim
         4. Stage     (front, 3D, -20° tilt) — tree + orbiters -->
  <div class="bonsai-back-context">
    <div class="bonsai-pot">
      <Pot class="block w-full" />
    </div>
  </div>

  <!-- Pot rim — same flat 2D plane as the soil, but classified under the
       pot family because it shares the pot's clay color and conceptually
       belongs to the container. Solid filled ellipse: the soil sits on
       top (slightly smaller) so the brown band visible around its edge
       reads as the pot's rim. Rendered BEFORE the soil so the soil
       paints on top. -->
  <svg
    class="bonsai-pot-rim"
    viewBox="0 0 350 140"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <ellipse cx="175" cy="70" rx="175" ry="70" class="bonsai-pot-rim-fill" />
  </svg>

  <svg
    class="bonsai-soil-flat"
    viewBox="0 0 350 140"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Filled green soil — sits on top of the pot rim, inset by 15 SVG
         units in each axis so the band of rim visible around it
         matches the original ~17 CSS px rim width. -->
    <ellipse cx="175" cy="70" rx="160" ry="55" class="bonsai-soil-fill" />
  </svg>

  <div class="bonsai-stage" data-bonsai-rotator>
    <!-- Central tree, billboarded, no orbit. Doubles as the button for the
         "main" experience (bonsaiTreeExperienceId) — same click contract as
         the plant orbiters via [data-experience-id]. -->
    <div
      class="bonsai-tree bonsai-clickable"
      data-experience-id={bonsaiTreeExperienceId}
      role="button"
      tabindex="0"
      aria-label={treeLabel}
      style={`color: ${bonsaiTreeColor};`}
    >
      <Tree class="block w-full" />
      <span class="bonsai-label bonsai-tree-label" aria-hidden="true">
        <span>{treeRole}</span>
        <span class="bonsai-label-sep">·</span>
        <span class="bonsai-label-company">{treeCompany}</span>
      </span>
    </div>

    <!-- Plants (experience-linked) scattered in inner and outer rings.
         Each plant doubles as a button: hover/focus reveals a tooltip
         (role · company), click/Enter opens that experience's popup via
         the `experience:open` event (see ExperiencePopup.astro). -->
    {
      bonsaiPlants.map((p) => {
        const job = experienceById.get(p.experienceId);
        if (!job) {
          throw new Error(
            `bonsai-mapping: unknown experienceId "${p.experienceId}"`,
          );
        }
        const role = job.role[locale];
        const company = job.shortName?.[locale] ?? job.company;
        const label = `${role} · ${company}`;
        const kind = p.kind ?? "plant";
        const Glyph = orbiterGlyphs[kind];
        return (
          <div
            class={`bonsai-orbiter bonsai-clickable bonsai-${kind}`}
            data-experience-id={p.experienceId}
            role="button"
            tabindex="0"
            aria-label={label}
            style={`color: ${p.color}; --theta: ${p.angle}deg; --r: ${p.radius}px; --tilt: ${p.tilt}deg; --scale: ${p.scale};`}
          >
            <Glyph class="block w-full" />
            <span class="bonsai-label bonsai-orbiter-label" aria-hidden="true">
              <span>{role}</span>
              <span class="bonsai-label-sep">·</span>
              <span class="bonsai-label-company">{company}</span>
            </span>
          </div>
        );
      })
    }

    <!-- Decorative orbiters (mushrooms, flowers, ...) — same orbit transform,
         smaller footprint than branches. Glyph dispatched by `kind`. -->
    {
      bonsaiDecorations.map((d) => {
        const Glyph = orbiterGlyphs[d.kind];
        return (
          <div
            class={`bonsai-orbiter bonsai-${d.kind}`}
            style={`color: ${d.color}; --theta: ${d.angle}deg; --r: ${d.radius}px; --tilt: ${d.tilt}deg; --scale: ${d.scale};`}
          >
            <Glyph class="block w-full" />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .bonsai-perspective {
    /* Single knob for the overall scene size. All fixed-px values below
       (max-width, perspective, soil ellipse, and the per-orbiter --r passed
       inline from bonsai-mapping.ts) multiply by this factor so the scene
       grows uniformly without touching the data. Percent-based sizes
       (pot/tree/plant width) scale automatically with max-width.
       Set back to 0.85 to share the hero viewport with the soil bag and
       leave room for the about/contact strips below — at 1.2 the scene
       took the entire screen on its own. */
    --bonsai-scale: 0.85;
    position: relative;
    width: 100%;
    max-width: calc(720px * var(--bonsai-scale));
    margin: 0 auto;
    /* Shorter aspect (was 640/580) trims empty space above the tree;
       pot width at max-width is 60% × 720 = 432px (× --bonsai-scale). */
    aspect-ratio: 720 / 520;
    /* Perspective scales with the scene so the foreshortening ratio stays
       constant — otherwise a bigger scene at the same camera distance reads
       as more dramatically perspective-skewed. */
    perspective: calc(1400px * var(--bonsai-scale));
    perspective-origin: 50% 50%;
  }

  .bonsai-back-context,
  .bonsai-stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* Shared bird's-eye tilt. Negative rotateX = looking down on the scene:
       points further from camera (back of orbit, -Z) rise on screen,
       points closer (front of orbit, +Z) sink.
       NOTE: this tilt only applies to the 3D contexts (pot body + stage).
       The flat .bonsai-soil-flat layer between them is 2D and doesn't
       tilt — plant orbits still compress vertically by sin(|angle|), so
       if this angle changes, the soil ellipse's ry/rx should grow to
       keep the inner edge just outside the largest plant projection. */
    transform: rotateX(-20deg);
    transform-origin: 50% 75%;
  }

  .bonsai-stage {
    /* Animated by GSAP. Clockwise from viewer = decreasing value. */
    --rotation: 0deg;
    cursor: grab;
    /* Allow vertical page scroll on touch; horizontal swipes rotate the scene. */
    touch-action: pan-y;
  }

  .bonsai-stage[data-bonsai-dragging] {
    cursor: grabbing;
  }

  /* Pot — centered, no Z offset (sits on rotation axis). Body trapezoid
     only; the visible rim is the separate .bonsai-pot-rim layer below.
     Width is wider than the soil ellipse so the body's top corners get
     tucked under the soil and the silhouette flows from soil outline
     into body edge. Negative `bottom` pushes the body past the
     container's bottom edge; combined with the back-context's -20° tilt
     and the perspective scaling, the body's visible base lands just
     inside the container edge instead of feeling cropped flat. */
  .bonsai-pot {
    position: absolute;
    left: 50%;
    bottom: -5%;
    width: 60%;
    transform: translate3d(-50%, 0, 0);
    color: var(--bonsai-clay);
  }

  /* Flat 2D soil (.bonsai-soil-flat) and the matching pot rim
     (.bonsai-pot-rim) share the same screen-space positioning so the
     stroked ellipse aligns with the filled one. Positioned the same way
     as the old 3D disc (left: 50%; bottom: 31% with translate(-50%, 50%)
     centers on the same point), so the tree and orbiters at bottom: 21%
     in the stage context still appear to sit on it. Outer ellipse
     350×140 (rx=175, ry=70) is sized so the inner edge of the 15 CSS px
     stroke clears the largest plant projection (r=155 → rx=155, ry=53).
     Fixed in px because plant orbit radii are also fixed in px.

     `bottom: 31%` lands the screen center on the pot body's post-tilt
     top edge (the pot occupies the bottom ~31% of the container in
     screen space). Width is scaled ×1.125 vs the viewBox to keep
     proportional to the 720px-max container, then multiplied by
     --bonsai-scale so the ellipse grows with the rest of the scene. */
  .bonsai-soil-flat,
  .bonsai-pot-rim {
    position: absolute;
    left: 50%;
    bottom: 31%;
    width: calc(394px * var(--bonsai-scale));
    height: calc(158px * var(--bonsai-scale));
    transform: translate(-50%, 50%);
    pointer-events: none;
  }
  .bonsai-soil-fill {
    fill: var(--bonsai-sage);
  }
  .bonsai-pot-rim-fill {
    fill: var(--bonsai-clay);
  }

  /* Tree — centered, billboarded at orbit center. No orbit transform applied.
     Also acts as a button (it carries .bonsai-clickable). Color is set
     inline from bonsaiTreeColor in the data module. */
  .bonsai-tree {
    position: absolute;
    left: 50%;
    bottom: 31%;
    /* SVG aspect is 64/139, so on-screen height ≈ width × 2.17. Tune
       width to set the tree's vertical footprint. */
    width: 15%;
    transform: translate3d(-50%, 0, 0);
  }
  .bonsai-tree:focus-visible {
    outline-offset: 6px;
    border-radius: 6px;
  }

  /* Orbiters — branches and decorations both orbit the central tree using
     this transform chain. Per-instance vars: --theta, --r, --scale, --tilt.
       1. translate -50% in X so the element's bottom-center sits on the anchor.
       2. rotateY by (θ + rotation): orients the local frame outward.
       3. translateZ(r): pushes the element out along local +Z.
       4. rotateY by -(θ + rotation): counter-rotation (billboard).
       5. rotate(tilt): organic in-plane lean.
       6. scale(scale): size variation.
  */
  .bonsai-orbiter {
    position: absolute;
    left: 50%;
    bottom: 31%;
    transform-origin: 50% 100%;
    /* Orbit transform — runs every frame via --rotation (driven by GSAP).
       Note: per-instance `scale(var(--scale))` was lifted out of this chain
       onto the standalone `scale` CSS property below, so the emergence
       animation can transition the visible size without smoothing the
       per-frame spin (which would happen if we put any transition on
       `transform`). */
    transform:
      translate3d(-50%, 0, 0)
      rotateY(calc(var(--theta) + var(--rotation, 0deg)))
      translate3d(0, 0, calc(var(--r, 100px) * var(--bonsai-scale)))
      rotateY(calc(-1 * (var(--theta) + var(--rotation, 0deg))))
      rotate(var(--tilt, 0deg));
    /* Emergence: hidden = opacity 0 + scale 0 (sucked into the soil at
       transform-origin 50% 100%). The standalone `scale` property composes
       with the `transform` matrix multiplicatively and uses the same
       transform-origin, so the orbiter visually grows up out of the dirt. */
    opacity: 0;
    scale: 0;
    pointer-events: none;
    transition:
      opacity 600ms ease-out,
      scale 700ms cubic-bezier(0.34, 1.5, 0.5, 1);
    will-change: transform, scale, opacity;
  }
  .bonsai-orbiter[data-orbit-state="revealed"],
  :root[data-skills-poured] .bonsai-orbiter {
    opacity: 1;
    scale: var(--scale, 1);
    pointer-events: auto;
  }
  /* Returning visitors skip the emergence transition entirely — orbiters
     are fully grown from first paint. */
  :root[data-skills-poured] .bonsai-orbiter {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .bonsai-orbiter {
      transition: none;
      opacity: 1;
      scale: var(--scale, 1);
    }
  }

  .bonsai-plant { width: 6%; }
  .bonsai-kinoko { width: 8%; }
  .bonsai-flower { width: 5%; }

  /* Bloom climax — fired once when the final skill chip is poured. A warm
     radial glow rises behind the scene; the central tree and every orbiter
     get a brief brightness pulse. After the animation ends the JS clears
     [data-bloom] and the scene settles into its filled steady state. */
  .bonsai-perspective {
    /* Single source of truth for the bloom climax length; CSS animations
       below all read this, and the JS that schedules [data-bloom] removal
       reads it via getComputedStyle so the attribute is cleared exactly
       when the animations end. */
    --bloom-duration: 2400ms;
    position: relative;
  }
  .bonsai-perspective[data-bloom]::after {
    content: "";
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      circle at 50% 65%,
      color-mix(in oklch, var(--bonsai-mustard) 50%, transparent) 0%,
      color-mix(in oklch, var(--bonsai-mustard) 20%, transparent) 30%,
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
    animation: bonsai-bloom-glow var(--bloom-duration) ease-out forwards;
  }
  @keyframes bonsai-bloom-glow {
    0% { opacity: 0; }
    18% { opacity: 1; }
    100% { opacity: 0; }
  }
  .bonsai-perspective[data-bloom] .bonsai-tree {
    animation: bonsai-bloom-tree var(--bloom-duration) ease-out;
  }
  @keyframes bonsai-bloom-tree {
    0%, 100% { filter: none; }
    25%, 60% {
      filter: brightness(1.15) drop-shadow(0 0 10px currentColor);
    }
  }
  .bonsai-perspective[data-bloom] .bonsai-orbiter {
    animation: bonsai-bloom-orbiter var(--bloom-duration) ease-out;
  }
  @keyframes bonsai-bloom-orbiter {
    0%, 100% { filter: none; }
    40%, 70% { filter: brightness(1.2) saturate(1.2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bonsai-perspective[data-bloom]::after,
    .bonsai-perspective[data-bloom] .bonsai-tree,
    .bonsai-perspective[data-bloom] .bonsai-orbiter {
      animation: none;
    }
  }

  .bonsai-tree svg,
  .bonsai-orbiter svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Clickable orbiters (experience plants) and the tree both act as buttons.
     The visible focus ring uses the element's bounding box, which for an
     orbiter sits at its bottom-center after the orbit transform — readable
     enough without fighting the 3D chain. Tree-specific offset/radius live
     on .bonsai-tree:focus-visible above. */
  .bonsai-clickable {
    cursor: pointer;
    outline: none;
  }
  .bonsai-clickable:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Shared label pill — used by clickable orbiters and the tree as a
     hover/focus tooltip. Per-variant transform overrides live in
     .bonsai-orbiter-label / .bonsai-tree-label below. */
  .bonsai-label {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    white-space: nowrap;
    display: inline-flex;
    gap: 0.4em;
    align-items: baseline;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 11px;
    line-height: 1.2;
    color: var(--color-fg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.35);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity 180ms ease;
    z-index: 2;
  }
  .bonsai-label-sep,
  .bonsai-label-company {
    color: var(--color-muted);
  }

  /* Orbiter variant — the orbiter applies rotate(tilt) then scale(s) last in
     its transform chain, so cancelling those two leaves the label billboarded,
     upright, and at a constant readable size across orbiters. transform-origin
     pins the bottom-center to the orbiter top so scale grows the label upward,
     away from the silhouette. */
  .bonsai-orbiter-label {
    transform:
      translateX(-50%)
      rotate(calc(-1 * var(--tilt, 0deg)))
      scale(calc(1 / var(--scale, 1)));
    transform-origin: 50% 100%;
  }

  /* Tree variant — no transform-cancel needed (the tree doesn't tilt/scale);
     sits slightly higher to clear the foliage. */
  .bonsai-tree-label {
    bottom: calc(100% + 8px);
  }

  /* Hover-driven reveal is gated to pointer-capable devices so iOS doesn't
     leave the label stuck on after a tap. Keyboard focus always reveals. */
  @media (hover: hover) {
    .bonsai-clickable:hover .bonsai-label {
      opacity: 1;
    }
  }
  .bonsai-clickable:focus-visible .bonsai-label {
    opacity: 1;
  }

</style>

<script>
  import { gsap } from "gsap";

  const SPIN_DURATION_SEC = 60; // seconds per full revolution
  const DEG_PER_PX = 0.4; // horizontal drag sensitivity
  // Threshold prevents a tap on a plant (Phase 6) from being treated as a
  // drag; movement under this stays a click.
  const DRAG_THRESHOLD_PX = 4;

  type StageController = {
    state: { r: number };
    tween: gsap.core.Tween | null;
    cleanups: Array<() => void>;
  };

  // One controller per stage element. Killed on astro:before-swap so the old
  // tween stops writing --rotation to a detached element after a locale switch.
  // `cleanups` collects document-level listener removers (garden events) that
  // would otherwise accumulate across page-load events.
  const controllers = new WeakMap<HTMLElement, StageController>();

  function startAutoSpin(
    stage: HTMLElement,
    ctrl: StageController,
  ): gsap.core.Tween {
    // Each segment tweens 360deg over SPIN_DURATION_SEC, then chains the next
    // from the current value. Avoids GSAP's repeat-reset jump and lets the
    // spin resume seamlessly from wherever drag left state.r.
    return gsap.to(ctrl.state, {
      r: ctrl.state.r - 360, // negative = clockwise from viewer
      duration: SPIN_DURATION_SEC,
      ease: "none",
      onUpdate: () => {
        stage.style.setProperty("--rotation", `${ctrl.state.r}deg`);
      },
      onComplete: () => {
        ctrl.tween = startAutoSpin(stage, ctrl);
      },
    });
  }

  // Pause auto-spin once movement crosses the threshold, resume on release.
  // Under threshold the gesture stays a click — child orbiters receive
  // normal click events, used by `bindPlantClicks` for plant→experience
  // navigation. After a drag we set `suppressNextClick` so the synthetic
  // click that may follow pointerup doesn't trigger plant navigation.
  function bindPointerDrag(
    stage: HTMLElement,
    ctrl: StageController,
    reduceMotion: boolean,
  ) {
    let pointerDown = false;
    let dragging = false;
    let totalDx = 0;
    let lastX = 0;
    let suppressNextClick = false;

    stage.addEventListener("pointerdown", (e) => {
      pointerDown = true;
      dragging = false;
      totalDx = 0;
      lastX = e.clientX;
      // Clear any leftover suppression from a prior drag whose synthetic
      // click never arrived (e.g. pointercancel, or a movement large enough
      // that the browser skipped the click). Safe because clicks are
      // dispatched synchronously after pointerup, before this fires again.
      suppressNextClick = false;
      // Pointer capture is deferred until the threshold is crossed so a
      // sub-threshold tap still dispatches `click` on the original child.
    });

    stage.addEventListener("pointermove", (e) => {
      if (!pointerDown) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      if (!dragging) {
        totalDx += Math.abs(dx);
        if (totalDx > DRAG_THRESHOLD_PX) {
          dragging = true;
          stage.setAttribute("data-bonsai-dragging", "");
          stage.setPointerCapture(e.pointerId);
          ctrl.tween?.kill();
          ctrl.tween = null;
        }
      }
      if (dragging) {
        // Subtract so drag direction matches auto-spin: drag right →
        // r decreases → clockwise from viewer.
        ctrl.state.r += dx * DEG_PER_PX;
        stage.style.setProperty("--rotation", `${ctrl.state.r}deg`);
      }
    });

    const endPointer = (e: PointerEvent) => {
      if (!pointerDown) return;
      pointerDown = false;
      if (dragging) {
        dragging = false;
        suppressNextClick = true;
        stage.removeAttribute("data-bonsai-dragging");
        if (stage.hasPointerCapture(e.pointerId)) {
          stage.releasePointerCapture(e.pointerId);
        }
        if (!reduceMotion) {
          ctrl.tween = startAutoSpin(stage, ctrl);
        }
      }
    };

    stage.addEventListener("pointerup", endPointer);
    stage.addEventListener("pointercancel", endPointer);

    // Capture-phase: swallow one click after a drag so it doesn't bubble to
    // the plant-click handler. Registered here (not in bindPlantClicks) so
    // the suppression is colocated with the flag that sets it.
    stage.addEventListener(
      "click",
      (e) => {
        if (suppressNextClick) {
          suppressNextClick = false;
          e.stopImmediatePropagation();
          e.preventDefault();
        }
      },
      { capture: true },
    );
  }

  // Plant → experience navigation. Click or Enter/Space on a focused plant
  // dispatches `experience:open` with the role's id; `ExperiencePopup.astro`
  // listens for that event and opens the matching panel in a native <dialog>.
  // Decoupling via a custom event keeps this scene unaware of the modal's
  // implementation.
  function bindPlantClicks(stage: HTMLElement) {
    const plantFrom = (e: Event) =>
      e.target instanceof Element
        ? e.target.closest<HTMLElement>("[data-experience-id]")
        : null;

    const activate = (target: Element) => {
      const id = target.getAttribute("data-experience-id");
      if (!id) return;
      document.dispatchEvent(
        new CustomEvent("experience:open", { detail: { id } }),
      );
    };

    stage.addEventListener("click", (e) => {
      const target = plantFrom(e);
      if (target) activate(target);
    });

    stage.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      const target = plantFrom(e);
      if (!target) return;
      e.preventDefault();
      activate(target);
    });
  }

  // Garden coupling — orbiters (experience plants + decorations) start
  // hidden in CSS and emerge as skill chips pour out of SoilBag. SoilBag
  // dispatches:
  //   garden:tick   { emitted, total }  — one chip just landed
  //   garden:bloom                       — every chip is poured (climax)
  //   garden:reset                       — reset button cleared everything
  // BonsaiScene reveals orbiters proportionally on tick, flashes the bloom
  // animation on bloom, and resets state on reset. The pre-paint script in
  // BaseLayout sets <html data-skills-poured> for returning visitors so the
  // CSS shows everything from first paint (no FOUC, no animation replay).
  // Parses a CSS time value ("2400ms" or "2.4s") into milliseconds. Used to
  // sync the JS bloom-attribute teardown with the CSS keyframe length so the
  // duration lives in exactly one place (--bloom-duration on .bonsai-perspective).
  function parseCssDuration(value: string): number {
    const trimmed = value.trim();
    const num = Number.parseFloat(trimmed);
    if (!Number.isFinite(num)) return 0;
    return trimmed.endsWith("ms") ? num : num * 1000;
  }

  function bindGarden(
    perspective: HTMLElement,
    stage: HTMLElement,
    ctrl: StageController,
  ) {
    // Experience plants render first so the meaningful orbiters emerge
    // ahead of decorative filler. Order within each kind preserved.
    const plants = Array.from(
      stage.querySelectorAll<HTMLElement>(".bonsai-orbiter.bonsai-clickable"),
    );
    const decorations = Array.from(
      stage.querySelectorAll<HTMLElement>(
        ".bonsai-orbiter:not(.bonsai-clickable)",
      ),
    );
    const orbiters = [...plants, ...decorations];
    if (orbiters.length === 0) return;

    // The visible state is driven by CSS (`:root[data-skills-poured]` or
    // `[data-orbit-state="revealed"]`), but `inert` must be toggled
    // imperatively — CSS can't add/remove HTML attributes. Initial inert
    // mirrors visibility: returning visitors (pre-paint script has set
    // the root attribute) start with fully interactive orbiters; first-
    // time visitors start with everything inert until emergence.
    const alreadyPoured =
      document.documentElement.hasAttribute("data-skills-poured");
    for (const el of orbiters) {
      el.toggleAttribute("inert", !alreadyPoured);
    }

    function revealUpTo(n: number) {
      const target = Math.min(orbiters.length, Math.max(0, n));
      for (let i = 0; i < orbiters.length; i++) {
        if (i < target && orbiters[i].dataset.orbitState !== "revealed") {
          orbiters[i].dataset.orbitState = "revealed";
          orbiters[i].removeAttribute("inert");
        }
      }
    }

    let bloomTimer: number | null = null;
    function onTick(e: Event) {
      const detail = (e as CustomEvent<{ emitted: number; total: number }>)
        .detail;
      if (!detail || detail.total <= 0) return;
      const progress = detail.emitted / detail.total;
      revealUpTo(Math.floor(progress * orbiters.length));
    }
    function onBloom() {
      // Force every orbiter visible — the last tick's floor() can leave
      // the final orbiter just under threshold by a rounding margin.
      revealUpTo(orbiters.length);
      perspective.setAttribute("data-bloom", "");
      if (bloomTimer !== null) window.clearTimeout(bloomTimer);
      const durationMs = parseCssDuration(
        getComputedStyle(perspective).getPropertyValue("--bloom-duration"),
      );
      bloomTimer = window.setTimeout(() => {
        perspective.removeAttribute("data-bloom");
        bloomTimer = null;
      }, durationMs);
    }
    function onReset() {
      if (bloomTimer !== null) {
        window.clearTimeout(bloomTimer);
        bloomTimer = null;
      }
      perspective.removeAttribute("data-bloom");
      for (const el of orbiters) {
        delete el.dataset.orbitState;
        el.toggleAttribute("inert", true);
      }
    }

    document.addEventListener("garden:tick", onTick);
    document.addEventListener("garden:bloom", onBloom);
    document.addEventListener("garden:reset", onReset);
    ctrl.cleanups.push(() => {
      document.removeEventListener("garden:tick", onTick);
      document.removeEventListener("garden:bloom", onBloom);
      document.removeEventListener("garden:reset", onReset);
      if (bloomTimer !== null) window.clearTimeout(bloomTimer);
    });
  }

  function setupBonsai() {
    const stages = document.querySelectorAll<HTMLElement>(
      "[data-bonsai-rotator]:not([data-bonsai-init])",
    );
    if (stages.length === 0) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    for (const stage of stages) {
      stage.setAttribute("data-bonsai-init", "");

      const ctrl: StageController = {
        state: { r: 0 },
        tween: null,
        cleanups: [],
      };
      controllers.set(stage, ctrl);

      if (!reduceMotion) {
        ctrl.tween = startAutoSpin(stage, ctrl);
      }

      bindPointerDrag(stage, ctrl, reduceMotion);
      bindPlantClicks(stage);

      const perspective = stage.closest<HTMLElement>(".bonsai-perspective");
      if (perspective) bindGarden(perspective, stage, ctrl);
    }
  }

  function teardownBonsai() {
    document
      .querySelectorAll<HTMLElement>("[data-bonsai-rotator][data-bonsai-init]")
      .forEach((stage) => {
        const ctrl = controllers.get(stage);
        ctrl?.tween?.kill();
        ctrl?.cleanups.forEach((fn) => fn());
        controllers.delete(stage);
      });
  }

  document.addEventListener("astro:page-load", setupBonsai);
  document.addEventListener("astro:before-swap", teardownBonsai);
</script>
