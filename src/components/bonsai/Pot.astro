---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 280 150"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- rim as horizontal ellipse — rx/ry ratio matches the stage's ±20° tilt
       (ry/rx ≈ sin(20°) = 0.34) so it shares aspect with the soil disc.
       If BonsaiScene's stage tilt changes, update ry accordingly. -->
  <ellipse cx="140" cy="46" rx="135" ry="46" fill="currentColor" />
  <!-- body trapezoid extending below the rim -->
  <path d="M 35 46 L 245 46 L 225 138 L 55 138 Z" fill="currentColor" />
</svg>
