---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 320 140"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- Body trapezoid only. The pot's visible "rim" lives on the flat
       soil ellipse in BonsaiScene.astro (SVG inner stroke gives a
       uniform-thickness band that a tilted disc with a CSS border
       can't produce). Body's top tucks under the soil ellipse; the
       body extends past the bonsai-perspective container via the pot
       wrapper's negative `bottom`, so the visible base reads tall
       rather than cropped at the container edge. -->
  <path d="M 20 0 L 300 0 L 275 140 L 45 140 Z" fill="currentColor" />
</svg>
