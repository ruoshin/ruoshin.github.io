---
import { getLocale, ui } from "@/lib/i18n";

const locale = getLocale(Astro.currentLocale);
---

<div class="soil-bag-host">
  <div
    class="soil-bag"
    data-soil-bag
    data-state="sealed"
    role="button"
    tabindex="0"
    aria-label={ui.skillsBagOpen[locale]}
  >
  <svg
    class="soil-bag-svg"
    viewBox="0 0 220 280"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Bag body — a softly rounded sack. Filled with currentColor
         (--bonsai-clay) so it stays in the warm-tonal palette. -->
    <path
      class="soil-bag-body"
      d="M40 60
         Q 30 70  35 110
         L 30 240
         Q 28 268  56 270
         L 164 270
         Q 192 268  190 240
         L 185 110
         Q 190 70  180 60
         Z"
      fill="currentColor"
    />

    <!-- Top fold — falls away when cut. Separate path with its own
         transform-origin pinned to the cut line so the fold hinges open. -->
    <g class="soil-bag-top">
      <path
        d="M40 60
           Q 30 50  50 36
           Q 110 26  170 36
           Q 190 50  180 60
           Z"
        fill="currentColor"
        class="soil-bag-top-fill"
      />
      <path
        d="M65 42 L75 56 M105 36 L105 56 M145 42 L135 56"
        stroke="rgba(0,0,0,0.18)"
        stroke-width="1.5"
        stroke-linecap="round"
        fill="none"
      />
    </g>

    <!-- Dashed cut line just below the fold — fades to zero on cut. -->
    <line
      class="soil-bag-cut-line"
      x1="32"
      y1="62"
      x2="188"
      y2="62"
      stroke="var(--color-fg)"
      stroke-width="1.5"
      stroke-dasharray="5 4"
      stroke-linecap="round"
      fill="none"
    />

    <text
      class="soil-bag-hint"
      x="110"
      y="22"
      text-anchor="middle"
      font-size="11"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      fill="var(--color-muted)"
    >
      ✂ {ui.skillsBagHint[locale]} →
    </text>

    <g class="soil-bag-scissor" aria-hidden="true">
      <circle r="10" fill="var(--color-bg)" stroke="var(--color-fg)" stroke-width="1.5" />
      <path
        d="M-3 -3 L 3 3 M-3 3 L 3 -3"
        stroke="var(--color-fg)"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </g>

    <text
      class="soil-bag-label"
      x="110"
      y="170"
      text-anchor="middle"
      font-size="18"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      letter-spacing="2"
      fill="var(--color-bg)"
      opacity="0.85"
    >
      SKILLS
    </text>
    <text
      class="soil-bag-sublabel"
      x="110"
      y="190"
      text-anchor="middle"
      font-size="9"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      fill="var(--color-bg)"
      opacity="0.55"
    >
      {ui.skillsBagLabel[locale]}
    </text>

    <!-- Granule shower played once during cut (separate from the per-chip
         pour that happens later when the bag is picked up and tilted). -->
    <g class="soil-bag-pour" aria-hidden="true">
      {Array.from({ length: 14 }).map((_, i) => (
        <circle
          class="soil-bag-granule"
          cx={70 + ((i * 11) % 80)}
          cy="80"
          r={1.5 + (i % 3) * 0.6}
          style={`--g-delay: ${i * 60}ms; --g-x: ${(i % 5) * 6 - 12}px;`}
        />
      ))}
    </g>

    <!-- Invisible marker at the mouth (where pour-side ends up after the
         tilt). The physics script reads this element's bounding rect to
         compute the chip emission point in screen coordinates — keeping
         the maths simple since the SVG transform applies to it too. -->
    <circle
      class="soil-bag-mouth-marker"
      data-bag-mouth
      cx="110"
      cy="62"
      r="0.5"
      fill="none"
      stroke="none"
    />

    <!-- "Lift me" hint shown once the bag is opened. Faded in after the cut
         animation; fades out the moment the user grabs it. -->
    <text
      class="soil-bag-lift-hint"
      x="110"
      y="276"
      text-anchor="middle"
      font-size="10"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      fill="var(--color-muted)"
    >
      ↺ {ui.skillsBagTilt[locale]}
    </text>
  </svg>
  </div>

  <!-- Reset button — clears localStorage + chip state and snaps the bag
       back to sealed so the cut/pour interaction can be replayed. Lives
       outside the bag's transform context so it stays put when the bag
       tilts. Hidden while the bag is still sealed (nothing to reset). -->
  <button
    type="button"
    class="soil-bag-reset"
    data-soil-bag-reset
    aria-label={ui.skillsBagReset[locale]}
  >
    ↻ {ui.skillsBagReset[locale]}
  </button>
</div>

<style>
  .soil-bag-host {
    /* Stack: bag visually on top, reset button below. The host owns the
       layout slot so the bag can be transformed/lifted freely without
       reflowing surrounding content. */
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    max-width: 180px;
  }

  .soil-bag-reset {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: transparent;
    border: 1px dashed var(--color-border);
    border-radius: 9999px;
    padding: 3px 10px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 250ms ease,
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .soil-bag-reset:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: color-mix(in oklch, var(--color-accent) 8%, transparent);
  }
  .soil-bag-reset:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* Reveal once the bag has progressed past sealed. Sibling selector works
     because the reset button comes after .soil-bag in the host. */
  .soil-bag:not([data-state="sealed"]) ~ .soil-bag-reset {
    opacity: 1;
    pointer-events: auto;
  }

  .soil-bag {
    position: relative;
    display: inline-block;
    width: 100%;
    max-width: 180px;
    color: var(--bonsai-clay);
    /* Cut phase = ew-resize (horizontal swipe); opened/empty get reset by
       the state rules below so the cursor matches what's actually
       interactive at each step. */
    cursor: ew-resize;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    /* Sealed allows page scroll past the bag; state rules below switch to
       `none` so dragging the opened bag isn't stolen by vertical scroll. */
    touch-action: pan-y;
    --cut-progress: 0;
    --bag-dx: 0px;
    --bag-dy: 0px;
    --bag-rot: 0deg;
    transform: translate(var(--bag-dx), var(--bag-dy)) rotate(var(--bag-rot));
    /* No transform transition by default — set conditionally so dragging
       feels 1:1 and only the return-to-rest animates. */
    transition: transform 400ms cubic-bezier(0.34, 1.3, 0.6, 1);
    z-index: 5;
  }
  /* While the user is actively dragging, kill the transition so the bag
     follows the pointer exactly. */
  .soil-bag[data-dragging="1"] {
    transition: none;
  }
  .soil-bag[data-state="opened"] {
    cursor: grab;
    touch-action: none;
  }
  .soil-bag[data-state="holding"],
  .soil-bag[data-state="tilting"] {
    cursor: grabbing;
    touch-action: none;
    z-index: 50;
  }
  .soil-bag[data-state="empty"] {
    cursor: grab;
    touch-action: none;
    opacity: 0.85;
  }
  /* iOS Safari doesn't always honour user-select: none on SVG <text>. */
  .soil-bag-svg text {
    user-select: none;
    -webkit-user-select: none;
  }
  .soil-bag:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 8px;
  }
  .soil-bag-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Soft glowing halo around the sealed bag — entry-point cue. ::before
     sits behind the SVG (z-index -1 inside the bag's local stacking
     context). The two-stage animation waits for the bag's drop-in to
     finish, fades in, then enters a slow breathing loop. Disappears as
     soon as the bag leaves the sealed state. */
  .soil-bag::before {
    content: "";
    position: absolute;
    inset: -16%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklch, var(--color-accent) 38%, transparent) 0%,
      transparent 65%
    );
    filter: blur(18px);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Halo waits for the bag's drop-in to settle (var --hero-drop-bag-end
     in global.css), fades in, then enters a slow breathing loop. */
  .soil-bag[data-state="sealed"]::before {
    animation:
      bag-halo-in 700ms ease-out var(--hero-drop-bag-end) forwards,
      bag-halo-breathe 3.2s ease-in-out
        calc(var(--hero-drop-bag-end) + 700ms) infinite;
  }
  @keyframes bag-halo-in {
    from { opacity: 0; transform: scale(0.82); }
    to   { opacity: 1; transform: scale(1); }
  }
  /* 0%/100% match bag-halo-in's end state (opacity 1, scale 1) so the
     handoff is seamless; the breath dips down to 0.78 at the midpoint. */
  @keyframes bag-halo-breathe {
    0%, 100% { opacity: 1;    transform: scale(1); }
    50%      { opacity: 0.78; transform: scale(1.08); }
  }

  /* --- Phase 1: cut animation (same as before) --- */
  .soil-bag-top {
    transform-origin: 110px 60px;
    transition:
      transform 700ms cubic-bezier(0.34, 1.2, 0.64, 1),
      opacity 600ms ease-out 200ms;
  }
  .soil-bag[data-state="sealed"] .soil-bag-top {
    transform:
      rotate(calc(var(--cut-progress) * -28deg))
      translate(0, calc(var(--cut-progress) * 6px));
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-top {
    transform: rotate(-110deg) translate(-30px, 40px);
    opacity: 0;
  }

  .soil-bag-cut-line {
    opacity: calc(0.55 - var(--cut-progress) * 0.55);
    transition: opacity 300ms ease;
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-cut-line {
    opacity: 0;
  }

  .soil-bag-hint {
    transition: opacity 250ms ease;
    opacity: 0.9;
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-hint {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .soil-bag[data-state="sealed"] .soil-bag-hint {
      animation: bag-hint-pulse 2.6s ease-in-out infinite;
    }
  }
  @keyframes bag-hint-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }

  .soil-bag-scissor {
    transform: translate(calc(32px + var(--cut-progress) * 156px), 62px);
    transition: transform 60ms linear;
  }
  .soil-bag[data-state="sealed"] .soil-bag-scissor {
    opacity: calc(0.4 + var(--cut-progress) * 0.6);
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-scissor {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .soil-bag[data-state="sealed"] .soil-bag-scissor {
      animation: bag-scissor-nudge 2.6s ease-in-out infinite;
    }
  }
  @keyframes bag-scissor-nudge {
    0%, 100% { translate: 0 0; }
    50%      { translate: 4px 0; }
  }

  .soil-bag-label,
  .soil-bag-sublabel {
    transition: opacity 400ms ease;
  }

  /* Granule shower fired during cut only. */
  .soil-bag-granule {
    fill: var(--bonsai-mustard);
    opacity: 0;
  }
  .soil-bag[data-state="cutting"] .soil-bag-granule {
    animation: bag-granule-fall 900ms cubic-bezier(0.4, 0, 0.7, 0.4) forwards;
    animation-delay: var(--g-delay, 0ms);
  }
  @keyframes bag-granule-fall {
    0% { opacity: 0; transform: translate(0, -10px); }
    20% { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate(var(--g-x, 0px), 200px);
    }
  }

  /* --- Phase 2: lift hint --- */
  .soil-bag-lift-hint {
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .soil-bag[data-state="opened"] .soil-bag-lift-hint {
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: no-preference) {
    .soil-bag[data-state="opened"] .soil-bag-lift-hint {
      animation: bag-lift-pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes bag-lift-pulse {
    0%, 100% { opacity: 0.45; }
    50%      { opacity: 1; }
  }
  .soil-bag[data-state="holding"] .soil-bag-lift-hint,
  .soil-bag[data-state="tilting"] .soil-bag-lift-hint,
  .soil-bag[data-state="empty"] .soil-bag-lift-hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .soil-bag-top,
    .soil-bag-cut-line,
    .soil-bag-hint,
    .soil-bag-scissor,
    .soil-bag-label,
    .soil-bag-sublabel,
    .soil-bag-lift-hint {
      transition: none !important;
    }
    .soil-bag-granule {
      animation: none !important;
    }
  }
</style>

<script>
  import { setupBags, teardownBags } from "@/lib/soil-bag";

  document.addEventListener("astro:page-load", setupBags);
  document.addEventListener("astro:before-swap", teardownBags);
</script>
