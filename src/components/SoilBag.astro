---
import { getLocale, ui } from "@/lib/i18n";

const locale = getLocale(Astro.currentLocale);
---

<div class="soil-bag-host">
  <div
    class="soil-bag"
    data-soil-bag
    data-state="sealed"
    role="button"
    tabindex="0"
    aria-label={ui.skillsBagOpen[locale]}
  >
  <svg
    class="soil-bag-svg"
    viewBox="0 0 220 280"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Bag body — a softly rounded sack. Filled with currentColor
         (--bonsai-clay) so it stays in the warm-tonal palette. -->
    <path
      class="soil-bag-body"
      d="M40 60
         Q 30 70  35 110
         L 30 240
         Q 28 268  56 270
         L 164 270
         Q 192 268  190 240
         L 185 110
         Q 190 70  180 60
         Z"
      fill="currentColor"
    />

    <!-- Top fold — falls away when cut. Separate path with its own
         transform-origin pinned to the cut line so the fold hinges open. -->
    <g class="soil-bag-top">
      <path
        d="M40 60
           Q 30 50  50 36
           Q 110 26  170 36
           Q 190 50  180 60
           Z"
        fill="currentColor"
        class="soil-bag-top-fill"
      />
      <path
        d="M65 42 L75 56 M105 36 L105 56 M145 42 L135 56"
        stroke="rgba(0,0,0,0.18)"
        stroke-width="1.5"
        stroke-linecap="round"
        fill="none"
      />
    </g>

    <!-- Dashed cut line just below the fold — fades to zero on cut. -->
    <line
      class="soil-bag-cut-line"
      x1="32"
      y1="62"
      x2="188"
      y2="62"
      stroke="var(--color-fg)"
      stroke-width="1.5"
      stroke-dasharray="5 4"
      stroke-linecap="round"
      fill="none"
    />

    <text
      class="soil-bag-hint"
      x="110"
      y="22"
      text-anchor="middle"
      font-size="11"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      fill="var(--color-muted)"
    >
      ✂ {ui.skillsBagHint[locale]} →
    </text>

    <g class="soil-bag-scissor" aria-hidden="true">
      <circle r="10" fill="var(--color-bg)" stroke="var(--color-fg)" stroke-width="1.5" />
      <path
        d="M-3 -3 L 3 3 M-3 3 L 3 -3"
        stroke="var(--color-fg)"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </g>

    <text
      class="soil-bag-label"
      x="110"
      y="170"
      text-anchor="middle"
      font-size="18"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      letter-spacing="2"
      fill="var(--color-bg)"
      opacity="0.85"
    >
      SKILLS
    </text>
    <text
      class="soil-bag-sublabel"
      x="110"
      y="190"
      text-anchor="middle"
      font-size="9"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      fill="var(--color-bg)"
      opacity="0.55"
    >
      {ui.skillsBagLabel[locale]}
    </text>

    <!-- Granule shower played once during cut (separate from the per-chip
         pour that happens later when the bag is picked up and tilted). -->
    <g class="soil-bag-pour" aria-hidden="true">
      {Array.from({ length: 14 }).map((_, i) => (
        <circle
          class="soil-bag-granule"
          cx={70 + ((i * 11) % 80)}
          cy="80"
          r={1.5 + (i % 3) * 0.6}
          style={`--g-delay: ${i * 60}ms; --g-x: ${(i % 5) * 6 - 12}px;`}
        />
      ))}
    </g>

    <!-- Invisible marker at the mouth (where pour-side ends up after the
         tilt). The physics script reads this element's bounding rect to
         compute the chip emission point in screen coordinates — keeping
         the maths simple since the SVG transform applies to it too. -->
    <circle
      class="soil-bag-mouth-marker"
      data-bag-mouth
      cx="110"
      cy="62"
      r="0.5"
      fill="none"
      stroke="none"
    />

    <!-- "Lift me" hint shown once the bag is opened. Faded in after the cut
         animation; fades out the moment the user grabs it. -->
    <text
      class="soil-bag-lift-hint"
      x="110"
      y="276"
      text-anchor="middle"
      font-size="10"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      fill="var(--color-muted)"
    >
      ↺ {ui.skillsBagTilt[locale]}
    </text>
  </svg>
  </div>

  <!-- Reset button — clears localStorage + chip state and snaps the bag
       back to sealed so the cut/pour interaction can be replayed. Lives
       outside the bag's transform context so it stays put when the bag
       tilts. Hidden while the bag is still sealed (nothing to reset). -->
  <button
    type="button"
    class="soil-bag-reset"
    data-soil-bag-reset
    aria-label={ui.skillsBagReset[locale]}
  >
    ↻ {ui.skillsBagReset[locale]}
  </button>
</div>

<style>
  .soil-bag-host {
    /* Stack: bag visually on top, reset button below. The host owns the
       layout slot so the bag can be transformed/lifted freely without
       reflowing surrounding content. */
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    max-width: 180px;
  }

  .soil-bag-reset {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: transparent;
    border: 1px dashed var(--color-border);
    border-radius: 9999px;
    padding: 3px 10px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 250ms ease,
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .soil-bag-reset:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: color-mix(in oklch, var(--color-accent) 8%, transparent);
  }
  .soil-bag-reset:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* Reveal once the bag has progressed past sealed. Sibling selector works
     because the reset button comes after .soil-bag in the host. */
  .soil-bag:not([data-state="sealed"]) ~ .soil-bag-reset {
    opacity: 1;
    pointer-events: auto;
  }

  .soil-bag {
    position: relative;
    display: inline-block;
    width: 100%;
    max-width: 180px;
    color: var(--bonsai-clay);
    /* Cut phase = ew-resize (horizontal swipe); opened/empty get reset by
       the state rules below so the cursor matches what's actually
       interactive at each step. */
    cursor: ew-resize;
    outline: none;
    user-select: none;
    touch-action: pan-y;
    --cut-progress: 0;
    --bag-dx: 0px;
    --bag-dy: 0px;
    --bag-rot: 0deg;
    transform: translate(var(--bag-dx), var(--bag-dy)) rotate(var(--bag-rot));
    /* No transform transition by default — set conditionally so dragging
       feels 1:1 and only the return-to-rest animates. */
    transition: transform 400ms cubic-bezier(0.34, 1.3, 0.6, 1);
    z-index: 5;
  }
  /* While the user is actively dragging, kill the transition so the bag
     follows the pointer exactly. */
  .soil-bag[data-dragging="1"] {
    transition: none;
  }
  .soil-bag[data-state="opened"] {
    cursor: grab;
  }
  .soil-bag[data-state="holding"],
  .soil-bag[data-state="tilting"] {
    cursor: grabbing;
    z-index: 50;
  }
  .soil-bag[data-state="empty"] {
    cursor: grab;
    opacity: 0.85;
  }
  .soil-bag:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 8px;
  }
  .soil-bag-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Soft glowing halo around the sealed bag — entry-point cue. ::before
     sits behind the SVG (z-index -1 inside the bag's local stacking
     context). The two-stage animation waits for the bag's drop-in to
     finish, fades in, then enters a slow breathing loop. Disappears as
     soon as the bag leaves the sealed state. */
  .soil-bag::before {
    content: "";
    position: absolute;
    inset: -16%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklch, var(--color-accent) 38%, transparent) 0%,
      transparent 65%
    );
    filter: blur(18px);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Halo waits for the bag's drop-in to settle (var --hero-drop-bag-end
     in global.css), fades in, then enters a slow breathing loop. */
  .soil-bag[data-state="sealed"]::before {
    animation:
      bag-halo-in 700ms ease-out var(--hero-drop-bag-end) forwards,
      bag-halo-breathe 3.2s ease-in-out
        calc(var(--hero-drop-bag-end) + 700ms) infinite;
  }
  @keyframes bag-halo-in {
    from { opacity: 0; transform: scale(0.82); }
    to   { opacity: 1; transform: scale(1); }
  }
  /* 0%/100% match bag-halo-in's end state (opacity 1, scale 1) so the
     handoff is seamless; the breath dips down to 0.78 at the midpoint. */
  @keyframes bag-halo-breathe {
    0%, 100% { opacity: 1;    transform: scale(1); }
    50%      { opacity: 0.78; transform: scale(1.08); }
  }

  /* --- Phase 1: cut animation (same as before) --- */
  .soil-bag-top {
    transform-origin: 110px 60px;
    transition:
      transform 700ms cubic-bezier(0.34, 1.2, 0.64, 1),
      opacity 600ms ease-out 200ms;
  }
  .soil-bag[data-state="sealed"] .soil-bag-top {
    transform:
      rotate(calc(var(--cut-progress) * -28deg))
      translate(0, calc(var(--cut-progress) * 6px));
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-top {
    transform: rotate(-110deg) translate(-30px, 40px);
    opacity: 0;
  }

  .soil-bag-cut-line {
    opacity: calc(0.55 - var(--cut-progress) * 0.55);
    transition: opacity 300ms ease;
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-cut-line {
    opacity: 0;
  }

  .soil-bag-hint {
    transition: opacity 250ms ease;
    opacity: 0.9;
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-hint {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .soil-bag[data-state="sealed"] .soil-bag-hint {
      animation: bag-hint-pulse 2.6s ease-in-out infinite;
    }
  }
  @keyframes bag-hint-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }

  .soil-bag-scissor {
    transform: translate(calc(32px + var(--cut-progress) * 156px), 62px);
    transition: transform 60ms linear;
  }
  .soil-bag[data-state="sealed"] .soil-bag-scissor {
    opacity: calc(0.4 + var(--cut-progress) * 0.6);
  }
  .soil-bag:not([data-state="sealed"]) .soil-bag-scissor {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .soil-bag[data-state="sealed"] .soil-bag-scissor {
      animation: bag-scissor-nudge 2.6s ease-in-out infinite;
    }
  }
  @keyframes bag-scissor-nudge {
    0%, 100% { translate: 0 0; }
    50%      { translate: 4px 0; }
  }

  .soil-bag-label,
  .soil-bag-sublabel {
    transition: opacity 400ms ease;
  }

  /* Granule shower fired during cut only. */
  .soil-bag-granule {
    fill: var(--bonsai-mustard);
    opacity: 0;
  }
  .soil-bag[data-state="cutting"] .soil-bag-granule {
    animation: bag-granule-fall 900ms cubic-bezier(0.4, 0, 0.7, 0.4) forwards;
    animation-delay: var(--g-delay, 0ms);
  }
  @keyframes bag-granule-fall {
    0% { opacity: 0; transform: translate(0, -10px); }
    20% { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate(var(--g-x, 0px), 200px);
    }
  }

  /* --- Phase 2: lift hint --- */
  .soil-bag-lift-hint {
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .soil-bag[data-state="opened"] .soil-bag-lift-hint {
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: no-preference) {
    .soil-bag[data-state="opened"] .soil-bag-lift-hint {
      animation: bag-lift-pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes bag-lift-pulse {
    0%, 100% { opacity: 0.45; }
    50%      { opacity: 1; }
  }
  .soil-bag[data-state="holding"] .soil-bag-lift-hint,
  .soil-bag[data-state="tilting"] .soil-bag-lift-hint,
  .soil-bag[data-state="empty"] .soil-bag-lift-hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .soil-bag-top,
    .soil-bag-cut-line,
    .soil-bag-hint,
    .soil-bag-scissor,
    .soil-bag-label,
    .soil-bag-sublabel,
    .soil-bag-lift-hint {
      transition: none !important;
    }
    .soil-bag-granule {
      animation: none !important;
    }
  }
</style>

<script>
  // ------------------------------------------------------------------
  // SoilBag — two-stage interaction:
  //   Stage 1 (cut): horizontal swipe ≥ CUT_THRESHOLD_PX opens the bag
  //   Stage 2 (lift + tilt): pointerdown grabs the bag; dragging left
  //     past TILT_THRESHOLD_DEG starts emitting one skill chip every
  //     EMIT_INTERVAL_MS via a per-chip physics simulation.
  // The chips live in BonsaiHero's .skills-grid; this script doesn't own
  // the chip DOM, it just toggles their data-state and drives their
  // transform via a single rAF loop.
  // ------------------------------------------------------------------

  const CUT_THRESHOLD_PX = 110;
  const TILT_THRESHOLD_DEG = -30;
  const EMIT_INTERVAL_MS = 95;
  const GRAVITY_PX_S2 = 1600;
  // Drag clamps are asymmetric: the bag starts on the right side of the
  // bonsai row, so it mostly needs to travel down and to the left to
  // reach the skills grid. Clamps loosened so the bag can comfortably
  // reach any cell on a wide monitor (skills grid stretches to the left
  // page margin) and any row including the bottom-most categories.
  const DRAG_X_LEFT_PX = -1200;
  const DRAG_X_RIGHT_PX = 400;
  const DRAG_Y_TOP_PX = -300;
  const DRAG_Y_BOTTOM_PX = 1000;
  const SETTLE_DURATION_MS = 520;

  const STORAGE_CUT = "skills-bag-cut";
  const STORAGE_EMPTIED = "skills-bag-emptied";

  type FlyingChip = {
    el: HTMLElement;
    dx: number;
    dy: number;
    vx: number;
    vy: number;
    rot: number;
    angVel: number;
  };

  function setProgress(bag: HTMLElement, p: number) {
    bag.style.setProperty("--cut-progress", String(Math.max(0, Math.min(1, p))));
  }

  function setTransform(
    bag: HTMLElement,
    dx: number,
    dy: number,
    rot: number,
  ) {
    bag.style.setProperty("--bag-dx", `${dx}px`);
    bag.style.setProperty("--bag-dy", `${dy}px`);
    bag.style.setProperty("--bag-rot", `${rot}deg`);
  }

  function getBagOffset(bag: HTMLElement) {
    return {
      dx: Number.parseFloat(bag.style.getPropertyValue("--bag-dx") || "0"),
      dy: Number.parseFloat(bag.style.getPropertyValue("--bag-dy") || "0"),
    };
  }

  function shuffled<T>(arr: T[]): T[] {
    const out = arr.slice();
    for (let i = out.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [out[i], out[j]] = [out[j], out[i]];
    }
    return out;
  }

  function bindBag(bag: HTMLElement) {
    if (bag.dataset.bagInit) return;
    bag.dataset.bagInit = "1";

    const mouthMarker = bag.querySelector<SVGCircleElement>("[data-bag-mouth]");
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ---- Garden coupling signals -------------------------------------
    // Mirror the "all skills poured" state to the html attribute (used by
    // CSS to show the bonsai's full population without animation on
    // returning visits) and fire the garden:* events that BonsaiScene
    // listens for. Centralised so the three call sites (auto-pour
    // completion, keyboard pour-all, reset) can't drift.
    function signalBloom() {
      document.documentElement.setAttribute("data-skills-poured", "");
      document.dispatchEvent(new CustomEvent("garden:bloom"));
    }
    function signalReset() {
      document.documentElement.removeAttribute("data-skills-poured");
      document.dispatchEvent(new CustomEvent("garden:reset"));
    }

    // ---- Chip references and per-category emission --------------------
    // Chips live in BonsaiHero's skills-grid. Group them by data-skill-
    // group so that pouring is driven by which category the bag is over
    // rather than a single flat order: each emit tick pops the next
    // unemitted chip from the active group.
    const allChips = Array.from(
      document.querySelectorAll<HTMLElement>("[data-skill-chip]"),
    );
    const skillRows = Array.from(
      document.querySelectorAll<HTMLElement>(".skills-row[data-group-index]"),
    );
    const chipsByGroup = new Map<number, HTMLElement[]>();
    for (const chip of allChips) {
      const g = Number(chip.dataset.skillGroup);
      const list = chipsByGroup.get(g) ?? [];
      list.push(chip);
      chipsByGroup.set(g, list);
    }
    // Shuffle within each group so repeat pours don't always start with
    // the same chip — the cross-category order is set by the user's drag.
    for (const [g, chips] of chipsByGroup) {
      chipsByGroup.set(g, shuffled(chips));
    }
    let activeGroups: Set<number> = new Set();
    let emittedTotal = 0;
    const totalChips = allChips.length;

    const flyingChips: FlyingChip[] = [];
    let rafId: number | null = null;
    let lastTickMs = 0;

    // Determine which skill rows the bag's mouth is currently over. The
    // hit-test rect is expanded vertically by the row's own height, so a
    // mouth centered on row N also falls inside the expanded bounds of the
    // rows directly above and below it in the same column — pouring spans
    // three vertically adjacent rows at once.
    function findActiveGroups(): Set<number> {
      const result = new Set<number>();
      if (!mouthMarker) return result;
      const m = mouthMarker.getBoundingClientRect();
      const px = m.left + m.width / 2;
      const py = m.top + m.height / 2;
      for (const row of skillRows) {
        const r = row.getBoundingClientRect();
        const expandY = r.height;
        if (
          px >= r.left &&
          px <= r.right &&
          py >= r.top - expandY &&
          py <= r.bottom + expandY
        ) {
          result.add(Number(row.dataset.groupIndex));
        }
      }
      return result;
    }

    function setActiveGroups(groups: Set<number>) {
      if (
        groups.size === activeGroups.size &&
        [...groups].every((g) => activeGroups.has(g))
      ) {
        return;
      }
      activeGroups = groups;
      for (const row of skillRows) {
        if (activeGroups.has(Number(row.dataset.groupIndex))) {
          row.dataset.active = "1";
        } else {
          delete row.dataset.active;
        }
      }
    }

    // ---- Resume from localStorage ------------------------------------
    let alreadyCut = false;
    let alreadyEmptied = false;
    try {
      alreadyCut = localStorage.getItem(STORAGE_CUT) === "1";
      alreadyEmptied = localStorage.getItem(STORAGE_EMPTIED) === "1";
    } catch {
      // ignore (private mode etc.)
    }

    // ---- Physics tick ------------------------------------------------
    function tick(now: number) {
      if (!lastTickMs) lastTickMs = now;
      // Clamp dt so a stalled tab doesn't fling chips off-screen.
      const dt = Math.min(0.05, (now - lastTickMs) / 1000);
      lastTickMs = now;

      for (let i = flyingChips.length - 1; i >= 0; i--) {
        const c = flyingChips[i];
        c.vy += GRAVITY_PX_S2 * dt;
        c.dx += c.vx * dt;
        c.dy += c.vy * dt;
        c.rot += c.angVel * dt;
        c.el.style.transform = `translate(${c.dx}px, ${c.dy}px) rotate(${c.rot}deg)`;

        // Settle once the chip has fallen back to its grid Y. The settling
        // state has a 520ms CSS transition that tweens the transform back
        // to (0,0) — effectively pulling the chip horizontally to its grid
        // X slot in a bouncy arc.
        if (c.dy >= 0) {
          c.el.dataset.state = "settling";
          c.el.style.transform = "translate(0, 0) rotate(0deg)";
          flyingChips.splice(i, 1);
          window.setTimeout(() => {
            c.el.dataset.state = "settled";
          }, SETTLE_DURATION_MS);
        }
      }

      if (flyingChips.length > 0) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = null;
        lastTickMs = 0;
      }
    }

    // Returns:
    //   "done"  — every currently-active group is drained (keep timer running
    //             so the user can move to another group)
    //   "all"   — every chip across every group is poured (stop everything)
    //   "ok"    — one chip emitted
    //   "idle"  — bag isn't over any group right now (timer keeps ticking)
    function emitNext(): "ok" | "done" | "all" | "idle" {
      if (emittedTotal >= totalChips) return "all";
      if (activeGroups.size === 0) return "idle";
      // Among the currently-active rows, gather any group that still has
      // hidden chips and pick one at random — gives a mixed pour across
      // the vertically adjacent rows rather than draining them in order.
      const candidates: { g: number; chips: HTMLElement[] }[] = [];
      for (const g of activeGroups) {
        const chips = chipsByGroup.get(g);
        if (chips?.some((c) => c.dataset.state === "hidden")) {
          candidates.push({ g, chips });
        }
      }
      if (candidates.length === 0) return "done";
      const { chips: groupChips } =
        candidates[Math.floor(Math.random() * candidates.length)];
      const chip = groupChips.find((c) => c.dataset.state === "hidden");
      if (!chip) return "done";
      emittedTotal++;
      // Tell the bonsai a chip has landed — BonsaiScene grows one more
      // orbiter when its share of the pour crosses the next threshold.
      document.dispatchEvent(
        new CustomEvent("garden:tick", {
          detail: { emitted: emittedTotal, total: totalChips },
        }),
      );

      if (reduceMotion || !mouthMarker) {
        chip.dataset.state = "settled";
        return "ok";
      }
      const mouthRect = mouthMarker.getBoundingClientRect();
      const chipRect = chip.getBoundingClientRect();
      const initDx = mouthRect.left + mouthRect.width / 2 - (chipRect.left + chipRect.width / 2);
      const initDy = mouthRect.top + mouthRect.height / 2 - (chipRect.top + chipRect.height / 2);

      const fc: FlyingChip = {
        el: chip,
        dx: initDx,
        dy: initDy,
        // Pour direction follows the bag tilt: tilting left = leftward
        // velocity. Small randomness so chips don't stream in a perfect
        // line.
        vx: -120 - Math.random() * 80,
        vy: 40 + Math.random() * 40,
        rot: (Math.random() - 0.5) * 30,
        angVel: (Math.random() - 0.5) * 240,
      };
      chip.dataset.state = "emitted";
      chip.style.transform = `translate(${initDx}px, ${initDy}px) rotate(${fc.rot}deg)`;
      flyingChips.push(fc);

      if (rafId === null) {
        rafId = requestAnimationFrame(tick);
      }
      return "ok";
    }

    // ---- Emission scheduling ----------------------------------------
    // The interval keeps ticking as long as the bag is tilted; per-tick we
    // ask emitNext() what to do. The "all" verdict just stops the timer
    // and persists — the terminal state transition (→ empty) and any
    // drag-state cleanup are deferred to onPointerEndLift so an
    // in-progress gesture isn't interrupted mid-drag (which would re-
    // enable the bag's CSS transform-transition and unlock rotation).
    let emitTimer: number | null = null;
    function startEmission() {
      if (emitTimer !== null) return;
      emitTimer = window.setInterval(() => {
        const result = emitNext();
        if (result === "all") {
          stopEmission();
          try {
            localStorage.setItem(STORAGE_EMPTIED, "1");
          } catch {
            // ignore
          }
          signalBloom();
        }
      }, EMIT_INTERVAL_MS);
    }
    function stopEmission() {
      if (emitTimer !== null) {
        window.clearInterval(emitTimer);
        emitTimer = null;
      }
    }

    // ---- Stage 2: pickup + tilt -------------------------------------
    let pointerDown = false;
    let startX = 0;
    let startY = 0;
    // Bag offset at pointerdown — subsequent drags add to this so the
    // bag doesn't snap back to (0,0) when re-grabbed at a moved position.
    let startBagDx = 0;
    let startBagDy = 0;
    // Tilt angle locks once the pour starts; only deepens (more negative)
    // until pointer release. Without this, moving the bag horizontally
    // across categories would un-tilt it and stop the pour mid-gesture.
    let lockedRot = 0;

    function onPointerDownLift(e: PointerEvent) {
      // Allow pickup in both "opened" and "empty" — once everything has
      // been poured the bag is still a draggable prop, just with no chips
      // left to emit (emitNext() returns "all" on the next tick).
      if (bag.dataset.state !== "opened" && bag.dataset.state !== "empty") {
        return;
      }
      pointerDown = true;
      startX = e.clientX;
      startY = e.clientY;
      ({ dx: startBagDx, dy: startBagDy } = getBagOffset(bag));
      lockedRot = 0;
      bag.setPointerCapture(e.pointerId);
      bag.dataset.state = "holding";
      bag.dataset.dragging = "1";
    }

    function onPointerMoveLift(e: PointerEvent) {
      if (!pointerDown) return;
      const rawDx = e.clientX - startX;
      const rawDy = e.clientY - startY;
      const dx = Math.max(
        DRAG_X_LEFT_PX,
        Math.min(DRAG_X_RIGHT_PX, startBagDx + rawDx),
      );
      const dy = Math.max(
        DRAG_Y_TOP_PX,
        Math.min(DRAG_Y_BOTTOM_PX, startBagDy + rawDy),
      );

      // Rotation candidate from horizontal pointer delta. Locked once
      // tilting; otherwise follows the drag with a steeper response so the
      // pouring pose reads more clearly without requiring a huge drag.
      const candidate = Math.max(-120, Math.min(15, rawDx * 0.75));
      let rot: number;
      if (bag.dataset.state === "tilting") {
        // Allow deeper tilt, never lighter. lockedRot stores the deepest
        // angle reached this gesture.
        if (candidate < lockedRot) lockedRot = candidate;
        rot = lockedRot;
      } else {
        rot = candidate;
      }
      setTransform(bag, dx, dy, rot);

      // Whichever category the bag's mouth is currently over becomes the
      // active group — emitNext() will read this on each tick. Updated on
      // every move so dragging across the grid switches groups live.
      setActiveGroups(findActiveGroups());

      // Enter tilting once the threshold is crossed; never auto-exit
      // (the only way out is pointerup). This is the "don't rebound"
      // behaviour: moving horizontally to a category doesn't level the
      // bag.
      if (
        bag.dataset.state !== "tilting" &&
        rot <= TILT_THRESHOLD_DEG
      ) {
        bag.dataset.state = "tilting";
        lockedRot = rot;
        startEmission();
      }
    }

    function onPointerEndLift(e: PointerEvent) {
      if (!pointerDown) return;
      pointerDown = false;
      if (bag.hasPointerCapture(e.pointerId)) {
        bag.releasePointerCapture(e.pointerId);
      }
      stopEmission();
      setActiveGroups(new Set());
      lockedRot = 0;
      bag.removeAttribute("data-dragging");
      // Don't clobber a reset() that fired mid-drag (sealed comes from
      // the reset button). Otherwise the terminal state is decided here,
      // not in the emission tick, so an in-progress gesture finishes
      // smoothly even if the final chip poured before release.
      if (bag.dataset.state === "sealed") return;
      const nowEmpty = emittedTotal >= totalChips;
      bag.dataset.state = nowEmpty ? "empty" : "opened";
      // Empty bags spring back to their original slot — pouring is over,
      // the prop has no business sitting in the middle of the grid.
      // Non-empty bags stay where released so the user can return to the
      // same spot for the next pour; only rotation eases back to upright.
      if (nowEmpty) {
        setTransform(bag, 0, 0, 0);
      } else {
        bag.style.setProperty("--bag-rot", "0deg");
      }
    }

    // ---- Stage 1: cut interaction ------------------------------------
    // Always bind cut handlers (they self-guard on state==sealed). Reset
    // can re-seal the bag and we want the cut gesture to work again
    // without re-binding, so these can't live behind a "first visit"
    // conditional.
    let cutPointerDown = false;
    let cutStartX = 0;
    bag.addEventListener("pointerdown", (e) => {
      if (bag.dataset.state !== "sealed") return;
      cutPointerDown = true;
      cutStartX = e.clientX;
      bag.setPointerCapture(e.pointerId);
    });
    bag.addEventListener("pointermove", (e) => {
      if (!cutPointerDown) return;
      const dx = e.clientX - cutStartX;
      if (dx <= 0) {
        setProgress(bag, 0);
        return;
      }
      setProgress(bag, dx / CUT_THRESHOLD_PX);
      if (dx >= CUT_THRESHOLD_PX) {
        cutPointerDown = false;
        if (bag.hasPointerCapture(e.pointerId)) {
          bag.releasePointerCapture(e.pointerId);
        }
        bag.dataset.state = "cutting";
        try {
          localStorage.setItem(STORAGE_CUT, "1");
        } catch {
          // ignore
        }
        window.setTimeout(() => {
          if (bag.dataset.state === "cutting") {
            bag.dataset.state = "opened";
            setProgress(bag, 1);
          }
        }, 950);
      }
    });
    const endCut = (e: PointerEvent) => {
      if (!cutPointerDown) return;
      cutPointerDown = false;
      if (bag.hasPointerCapture(e.pointerId)) {
        bag.releasePointerCapture(e.pointerId);
      }
      if (bag.dataset.state === "sealed") {
        setProgress(bag, 0);
      }
    };
    bag.addEventListener("pointerup", endCut);
    bag.addEventListener("pointercancel", endCut);

    // Stage 2 handlers are always bound — they only act when state==opened.
    bag.addEventListener("pointerdown", onPointerDownLift);
    bag.addEventListener("pointermove", onPointerMoveLift);
    bag.addEventListener("pointerup", onPointerEndLift);
    bag.addEventListener("pointercancel", onPointerEndLift);

    // ---- Reset button -------------------------------------------------
    // Snaps everything back to sealed state: cancels any in-flight pour,
    // hides all chips, clears localStorage, and re-shuffles the emission
    // order so the next pour lands in a different sequence.
    function reset() {
      stopEmission();
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      flyingChips.length = 0;
      lastTickMs = 0;
      for (const chip of allChips) {
        chip.dataset.state = "hidden";
        chip.style.transform = "";
      }
      // Re-shuffle within each group so the next pour lands in a
      // different order than this one.
      for (const [g, chips] of chipsByGroup) {
        chipsByGroup.set(g, shuffled(chips));
      }
      emittedTotal = 0;
      setActiveGroups(new Set());
      bag.removeAttribute("data-dragging");
      setProgress(bag, 0);
      setTransform(bag, 0, 0, 0);
      bag.dataset.state = "sealed";
      try {
        localStorage.removeItem(STORAGE_CUT);
        localStorage.removeItem(STORAGE_EMPTIED);
      } catch {
        // ignore
      }
      signalReset();
    }
    const resetBtn = bag.parentElement?.querySelector<HTMLButtonElement>(
      "[data-soil-bag-reset]",
    );
    if (resetBtn) {
      resetBtn.addEventListener("click", reset);
      // Stop pointerdown from bubbling into the bag (which would otherwise
      // treat the click as a swipe/lift attempt while the bag is opened).
      resetBtn.addEventListener("pointerdown", (e) => e.stopPropagation());
    }

    // ---- Restore from localStorage -----------------------------------
    // Applied after handlers bind so any state-dependent CSS picks up
    // immediately. Reset() restores the same way (state=sealed, chips
    // hidden), so this path only runs once on initial bindBag.
    if (alreadyEmptied) {
      bag.dataset.state = "empty";
      for (const chip of allChips) {
        chip.dataset.state = "settled";
      }
      emittedTotal = totalChips;
    } else if (alreadyCut) {
      bag.dataset.state = "opened";
      setProgress(bag, 1);
    }

    // Keyboard fallback: in sealed state Enter/Space cuts the bag without
    // a swipe; in opened state it pours every remaining chip with no
    // tilt gesture required.
    bag.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      if (bag.dataset.state === "sealed") {
        e.preventDefault();
        bag.dataset.state = "cutting";
        setProgress(bag, 1);
        try {
          localStorage.setItem(STORAGE_CUT, "1");
        } catch {
          // ignore
        }
        window.setTimeout(() => {
          bag.dataset.state = "opened";
        }, 950);
      } else if (bag.dataset.state === "opened") {
        e.preventDefault();
        // Emit all remaining without physics — accessibility shortcut.
        for (const chip of allChips) {
          if (chip.dataset.state !== "settled") {
            chip.dataset.state = "settled";
          }
        }
        emittedTotal = totalChips;
        bag.dataset.state = "empty";
        try {
          localStorage.setItem(STORAGE_EMPTIED, "1");
        } catch {
          // ignore
        }
        signalBloom();
      }
    });
  }

  function setupBags() {
    document
      .querySelectorAll<HTMLElement>("[data-soil-bag]")
      .forEach(bindBag);
  }

  document.addEventListener("astro:page-load", setupBags);
</script>
