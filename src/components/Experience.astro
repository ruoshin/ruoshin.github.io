---
import Decoration from "./Decoration.astro";
import ExternalLink from "./ExternalLink.astro";
import Section, { type SectionScheme } from "./Section.astro";
import { experience } from "@/data/experience";
import { getLocale, ui } from "@/lib/i18n";

const locale = getLocale(Astro.currentLocale);

const scheme: SectionScheme = {
  blob: { color: "accent", position: "top-32 -right-24 w-80" },
  spark: { color: "secondary", position: "top-8 right-24 w-6" },
  star: { color: "secondary", position: "bottom-10 right-8 w-7" },
};
---

<Section
  id="experience"
  label={ui.experienceLabel[locale]}
  title={ui.experienceTitle[locale]}
  scheme={scheme}
>
  <ol class="relative border-l-2 border-dashed border-[var(--color-border)] pl-6 space-y-12">
    {
      experience.map((job, idx) => (
        <li class="relative group">
          {idx === 0 ? (
            <span class="absolute -left-[34px] -top-0.5 size-6 transition-transform group-hover:scale-125">
              <Decoration
                variant="star"
                color="accent"
                class="deco-spin block w-full h-full"
              />
            </span>
          ) : (
            <span
              class={`absolute -left-[31px] top-1.5 size-3.5 rounded-full ring-4 ring-[var(--color-bg)] transition-transform group-hover:scale-125 ${idx % 2 === 1 ? "bg-[var(--color-secondary)]" : "bg-[var(--color-accent)]"}`}
            />
          )}
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg md:text-xl font-semibold tracking-tight">
              <span>{job.role[locale]}</span>
              <span class="text-[var(--color-muted)] font-normal">
                {" "}
                ·{" "}
                {job.href ? (
                  <ExternalLink
                    href={job.href}
                    class="hover:text-[var(--color-accent)] transition-colors"
                  >
                    {job.company}
                  </ExternalLink>
                ) : (
                  job.company
                )}
              </span>
            </h3>
            <span class="font-mono text-xs text-[var(--color-muted)] tabular-nums">
              {job.period}
            </span>
          </div>

          <p class="mt-3 text-[var(--color-fg)]/80 leading-relaxed">
            {job.summary[locale]}
          </p>

          {job.highlights.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm text-[var(--color-fg)]/80">
              {job.highlights.map((h) => (
                <li class="flex gap-2 leading-relaxed">
                  <span
                    class="mt-2 size-1 shrink-0 rounded-full bg-[var(--color-accent)]"
                    aria-hidden="true"
                  />
                  <span>{h[locale]}</span>
                </li>
              ))}
            </ul>
          )}

          {job.stack.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {job.stack.map((tech) => (
                <li class="font-mono text-[11px] px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">
                  {tech}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</Section>
