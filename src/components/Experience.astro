---
import Section from "./Section.astro";
import { experience } from "../data/experience";
---

<Section id="experience" label="Experience" title="Where I've built things.">
  <ol class="relative border-l border-[var(--color-border)] pl-6 space-y-12">
    {
      experience.map((job) => (
        <li class="relative">
          <span class="absolute -left-[29px] top-1.5 size-2.5 rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-bg)]" />
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg md:text-xl font-semibold tracking-tight">
              <span>{job.role}</span>
              <span class="text-[var(--color-muted)] font-normal">
                {" "}
                · {job.company}
              </span>
            </h3>
            <span class="font-mono text-xs text-[var(--color-muted)] tabular-nums">
              {job.period}
            </span>
          </div>

          <p class="mt-3 text-[var(--color-fg)]/80 leading-relaxed">
            {job.summary}
          </p>

          {job.highlights.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm text-[var(--color-fg)]/80">
              {job.highlights.map((h) => (
                <li class="flex gap-2 leading-relaxed">
                  <span
                    class="mt-2 size-1 shrink-0 rounded-full bg-[var(--color-muted)]"
                    aria-hidden="true"
                  />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}

          {job.stack.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {job.stack.map((tech) => (
                <li class="font-mono text-[11px] px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">
                  {tech}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</Section>
