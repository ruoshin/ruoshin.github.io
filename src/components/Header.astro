---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { profile } from "@/data/profile";
import { getLocale, localePath } from "@/lib/i18n";

const locale = getLocale(Astro.currentLocale);
const home = localePath(locale);
---

<header
  class="sticky top-0 z-30 backdrop-blur-md bg-[var(--color-bg)]/80 border-b border-[var(--color-border)]"
>
  <div
    class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between gap-6 xl:max-w-none xl:pl-sidebar"
  >
    <a
      href={`${home}#top`}
      class="font-mono text-sm tracking-tight hover:text-[var(--color-accent)] transition-colors"
    >
      {profile.name.toLowerCase().replace(" ", ".")}
    </a>
    <div class="flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>
</header>
