---
import Section from "./Section.astro";
import { profile } from "../data/profile";
import { getLocale, ui } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);

const facets = [
  {
    title: ui.aboutFacetFrontend[locale],
    body: ui.aboutFacetFrontendBody[locale],
  },
  {
    title: ui.aboutFacetBackend[locale],
    body: ui.aboutFacetBackendBody[locale],
  },
  {
    title: ui.aboutFacetDesign[locale],
    body: ui.aboutFacetDesignBody[locale],
  },
];
---

<Section
  id="about"
  label={ui.aboutLabel[locale]}
  title={ui.aboutTitle[locale]}
>
  <div class="space-y-6 text-[var(--color-fg)]/85 leading-relaxed">
    <p class="text-lg">
      {profile.bio[locale]}
    </p>
  </div>

  <div class="mt-10 grid sm:grid-cols-3 gap-4">
    {
      facets.map((facet) => (
        <div class="p-5 rounded-lg border border-[var(--color-border)] bg-[var(--color-subtle)]/40">
          <h3 class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">
            {facet.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg)]/80">
            {facet.body}
          </p>
        </div>
      ))
    }
  </div>
</Section>
