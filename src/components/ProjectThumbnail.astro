---
import { Image } from "astro:assets";
import ExternalLink from "@/components/ExternalLink.astro";
import type { ProjectImage } from "@/data/projects";
import type { Locale } from "@/lib/i18n";

interface Props {
  img: ProjectImage;
  locale: Locale;
}

const { img, locale } = Astro.props;

// Shared between the href and no-href branches so the two render paths can't
// drift on prop changes (sizes, widths, alt). The popup grid is single-column
// at all breakpoints, so sizes tracks the popup's effective inner width:
// dialog margin 2rem + card horizontal padding 2×1.75rem = 5.5rem;
// max card 900px − 2×1.75rem padding ≈ 836px.
const imageProps = {
  src: img.src,
  alt: img.alt[locale],
  widths: [400, 800, 1200],
  sizes: "(max-width: 900px) calc(100vw - 5.5rem), 836px",
  loading: "lazy" as const,
  class: "w-full h-auto block",
};
---

<li
  class="rounded-2xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-subtle)]"
>
  {
    img.href ? (
      <ExternalLink href={img.href} class="block">
        <Image {...imageProps} />
      </ExternalLink>
    ) : (
      <Image {...imageProps} />
    )
  }
</li>
