---
import ExternalLink from "./ExternalLink.astro";
import ProjectThumbnail from "./ProjectThumbnail.astro";
import Section, { type SectionScheme } from "./Section.astro";
import { otherImages, projects } from "@/data/projects";
import { getLocale, ui } from "@/lib/i18n";

const locale = getLocale(Astro.currentLocale);

const scheme: SectionScheme = {
  blob: { color: "secondary", position: "-top-10 -right-16 w-72" },
  spark: { color: "accent", position: "bottom-32 right-4 w-5" },
  star: { color: "accent", position: "top-16 -left-6 w-9" },
};
---

<Section
  id="projects"
  label={ui.projectsLabel[locale]}
  title={ui.projectsTitle[locale]}
  scheme={scheme}
>
  <div class="space-y-14">
    {
      projects.map((project) => (
        <article class="space-y-4">
          <header>
            <h3 class="text-lg md:text-xl font-semibold tracking-tight">
              {project.href ? (
                <ExternalLink
                  href={project.href}
                  class="hover:text-[var(--color-accent)] transition-colors"
                >
                  {project.name}
                  <span class="font-mono text-sm text-[var(--color-muted)]"> ↗</span>
                </ExternalLink>
              ) : (
                <span>{project.name}</span>
              )}
              {project.client && (
                <span class="text-[var(--color-muted)] font-normal">
                  {" "}
                  · {project.client[locale]}
                </span>
              )}
            </h3>
            {project.summary && (
              <p class="mt-2 text-[var(--color-fg)]/80 leading-relaxed">
                {project.summary[locale]}
              </p>
            )}
          </header>

          <ul class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {project.images.map((img) => (
              <ProjectThumbnail img={img} locale={locale} />
            ))}
          </ul>

          {project.stack && project.stack.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <li class="font-mono text-[11px] px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">
                  {tech}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }

    <article class="space-y-4">
      <header>
        <h3 class="text-lg md:text-xl font-semibold tracking-tight">
          {ui.projectsOthers[locale]}
        </h3>
        <p class="mt-2 text-[var(--color-fg)]/80 leading-relaxed">
          {ui.projectsOthersSummary[locale]}
        </p>
      </header>

      <ul class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {otherImages.map((img) => <ProjectThumbnail img={img} locale={locale} />)}
      </ul>
    </article>
  </div>
</Section>
